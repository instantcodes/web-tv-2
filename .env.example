# ==============================================================
# SECURE ENVIRONMENT CONFIGURATION
# ==============================================================
# WARNING: NEVER commit your actual .env file or sensitive IPTV 
# credentials to version control (git). Keep this .env.example safe.

# Server Port
PORT=3001

# Sensitive IPTV M3U Playlist Source
# Can be any public or private IPTV provider URL (Xtream, CloudFront, m3u, etc.)
# This is strictly kept on the backend and NEVER sent to the client browser.
PLAYLIST_URL= >>> SECRET_URL <<<

# Allowed Client Origin (for CORS security)
CORS_ORIGIN=http://localhost:5173

# Cache TTL in seconds (default: 1 hour / 3600s)
PLAYLIST_CACHE_TTL=3600

# Stream Protection & Obfuscation
# Set to 'true' to proxy streams through the backend, completely masking
# the upstream IPTV provider's IP and direct m3u8 URLs from client inspection.
ENABLE_STREAM_PROXY=false

# Secret key used for signing internal channel tokens
INTERNAL_SECRET_KEY=change_this_to_a_secure_random_string_in_production
